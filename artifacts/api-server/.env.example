PORT=4000
DATABASE_URL=postgresql://user:password@host:5432/dbname
JWT_SECRET=replace-with-a-long-random-string
RESEND_API_KEY=

# Flutterwave payment gateway
FLUTTERWAVE_PUBLIC_KEY=FLWPUBK_TEST-xxxxxxxxxxxxxxxxxxxxxxxxxxxx-X
FLUTTERWAVE_SECRET_KEY=FLWSECK_TEST-xxxxxxxxxxxxxxxxxxxxxxxxxxxx-X
FLUTTERWAVE_WEBHOOK_HASH=your-webhook-secret-hash

# Frontend URL (used for redirect_url and logo in Flutterwave payment)
FRONTEND_URL=https://your-frontend.vercel.app
