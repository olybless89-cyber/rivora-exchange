+            Shown as a "Join WhatsApp Group" button on the welcome splash screen.
+          </p>
+          <Label>Group Invite URL</Label>
+          <Input
+            style={{ margin: "8px 0 14px" }}
+            placeholder="https://chat.whatsapp.com/xxxxxxxxxxxxxxx"
+            value={waLoading ? "Loading…" : waUrl}
+            onChange={(e) => setWaUrl(e.target.value)}
+            disabled={waLoading}
+          />
+          <Button onClick={saveWaUrl} disabled={waSaving || waLoading} style={{ display: "flex", gap: 8 }}>
+            {waSaving ? <Loader2 size={14} className="animate-spin" /> : <Save size={14} />}
+            Save Link
+          </Button>
+        </Card>
+
+        {/* ── Single Email ──────────────────────────────────────── */}
+        <Card style={{ padding: 20 }}>
+          <h2 style={{ fontSize: 15, fontWeight: 700, color: "#fff", margin: "0 0 4px" }}>
+            ✉️ Send Email to One User
+          </h2>
+          <p style={{ fontSize: 12, color: "#9C9C9C", margin: "0 0 16px" }}>
+            Paste the user's ID from the Users page.
+          </p>
+          <div style={{ display: "flex", flexDirection: "column", gap: 10 }}>
